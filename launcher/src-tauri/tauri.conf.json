{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stream Overlay",
  "version": "0.2.0",
  "identifier": "com.multivarka.overlaystudio",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stream Overlay",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0e0e10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5QzA1NjgyQUMwRDMyOTAKUldTUU1nMnNnbGJBMmRMNGovUElITjVlUzdZVk5mcnJuOVA0VmgzVDFBblNRc2lzYmhhMnpuTCsK",
      "endpoints": [
        "https://github.com/multivarka01/overlay/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}